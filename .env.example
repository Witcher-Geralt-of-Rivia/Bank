# ---------------------------------------------------------------------------
# Aldera — environment configuration
# Copy to `.env.local` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Secret used to sign session tokens (HS256). Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, ...).
# Required in production. In development and tests, leaving it empty runs the
# embedded in-memory PostgreSQL engine, which is migrated and seeded on boot
# and resets when the process restarts.
DATABASE_URL=

# Lets a production build run on the embedded engine. Data is then held in one
# server process and lost on restart: use only for a disposable demo.
ALLOW_EMBEDDED_DATABASE=false

# Demo mode seeds realistic data and shows one-click demo sign-in on the login
# page. Set to "false" for a clean environment with no demo accounts.
DEMO_MODE=true

# Apply migrations (and seed, in demo mode) automatically on first connection
# to DATABASE_URL. Set to "false" to manage the schema with `npm run db:migrate`.
DB_AUTO_MIGRATE=true
